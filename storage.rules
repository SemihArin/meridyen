rules_version = '2';

/* Meridyen — Firebase Storage kuralları.
 *
 * Uygulama Storage'ı TEK bir düzende kullanıyor:
 *     medya/<sahibin uid'si>/<medyaId>
 * (bkz. index.html içindeki depoYolu() fonksiyonu). Başka hiçbir yola
 * yazılmıyor, bu yüzden burada da yalnız o yol açık; geri kalan her şey
 * Firebase'in varsayılanıyla kapalı kalıyor.
 *
 * ÖNEMLİ: Bu kuralları yüklemeden (ve projede Storage'ı açmadan) önce
 * uygulamadan görsel/video/dosya paylaşılamaz — yükleme "izin yok" ile
 * reddedilir.
 */
service firebase.storage {
  match /b/{bucket}/o {

    match /medya/{uid}/{medyaId} {

      /* OKUMA: giriş yapmış herkes.
         Medya sohbetlerde ve akışta paylaşılıyor, karşı tarafın da açabilmesi
         gerekiyor. Pratikte gösterim, yükleyenin aldığı ve veritabanına
         yazdığı jetonlu indirme adresi üzerinden oluyor; bu kural asıl
         getDownloadURL() çağrısını karşılıyor. */
      allow read: if request.auth != null;

      /* YAZMA (oluşturma, güncelleme ve silme):
         yalnız kendi klasörüne. Boyut sınırı uygulamadaki PAYLASIM_MAKS ile
         aynı: 700 MB.

         request.resource SİLME sırasında null oluyor — boyut denetimi bu
         yüzden yalnız gerçekten veri yazılırken uygulanıyor, yoksa kendi
         dosyanı silemezdin. */
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && (request.resource == null
                       || request.resource.size <= 700 * 1024 * 1024);
    }
  }
}
