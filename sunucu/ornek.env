# Meridyen bildirim sunucusu — ayarlar.
# kur.sh bu dosyayı .env olarak kopyalayıp anahtar satırını kendisi doldurur.
# Sunucu .env'i kendisi okur (paket ya da `set -a` gerekmez); ortamda zaten
# tanımlı bir değişken buradakini ezer. .env depoya girmiyor.

# Servis hesabı anahtarının DOSYA YOLU (önerilen).
# Firebase konsolu > Proje ayarları > Servis hesapları > Yeni özel anahtar üret
MERIDYEN_SERVIS_HESABI_DOSYASI=

# Alternatif: anahtarın JSON İÇERİĞİ tek satır, tırnaksız (üsttekini sil).
# Dosya yolu varken kur.sh bu satırı yoruma alır.
# MERIDYEN_SERVIS_HESABI={"type":"service_account","project_id":"meridyen-830fb", ... }

# Veritabanı adresi (varsayılan zaten bu, değiştirmen gerekmiyor)
# MERIDYEN_DB=https://meridyen-830fb-default-rtdb.europe-west1.firebasedatabase.app

# Sağlık ucu portu (0 = kapalı)
# PORT=8080

# Nabız ve güvenlik taraması aralığı (sn)
# MERIDYEN_NABIZ_SN=60
# MERIDYEN_TARAMA_SN=30

# Günlük ayrıntısı: DEBUG, INFO, WARNING
# MERIDYEN_GUNLUK=INFO
