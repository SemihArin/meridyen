# Meridyen bildirim sunucusu — systemd hizmeti ŞABLONU.
#
# Elle kopyalama: kur.sh @KULLANICI@ ve @DIZIN@ yerlerini doldurup
# /etc/systemd/system/ altına kendisi kuruyor. Doldurulmuş hâlini görmek için:
#   ./kur.sh --hizmet-dosyasi
#
# Ayarlar (.env) hizmet tanımında DEĞİL: sunucu .env'i kendisi okuyor. Böylece
# elle çalıştırmak ile hizmet olarak çalıştırmak aynı dosyayı aynı kurallarla
# okuyor (systemd'nin kendi okuyucusu tırnakları farklı yorumluyordu).

[Unit]
Description=Meridyen bildirim sunucusu
# Ağ gerçekten gelmeden başlamasın (Raspberry Pi açılışında Wi-Fi geç gelebiliyor).
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=@KULLANICI@
WorkingDirectory=@DIZIN@
ExecStart=@DIZIN@/venv/bin/python @DIZIN@/sunucu.py
# Çökerse ya da bekçi takılmayı fark edip süreci bitirirse yeniden başlat.
# Sınırsız: ağ saatlerce yoksa bile vazgeçmesin.
Restart=always
RestartSec=5
StartLimitIntervalSec=0
# SIGTERM'den sonra düzgün kapanması için süre
TimeoutStopSec=20
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
